# ========================================
# SOAR Pro - Environment Configuration
# ========================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!

# ========================================
# General Settings
# ========================================
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# ========================================
# PostgreSQL Database
# ========================================
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=soar_db
POSTGRES_USER=soar_user
POSTGRES_PASSWORD=ChangeMe_SecurePassword123!

# Connection pool
POSTGRES_POOL_MIN=5
POSTGRES_POOL_MAX=20

# ========================================
# Elasticsearch
# ========================================
ELASTICSEARCH_HOST=elasticsearch
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_USER=elastic
ELASTICSEARCH_PASSWORD=ChangeMe_ElasticPassword123!

# ========================================
# Redis
# ========================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=ChangeMe_RedisPassword123!
REDIS_DB=0

# ========================================
# MinIO (S3-compatible storage)
# ========================================
MINIO_HOST=minio
MINIO_PORT=9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=ChangeMe_MinioPassword123!
MINIO_BUCKET_NAME=soar-evidence

# ========================================
# JWT Authentication
# ========================================
JWT_SECRET_KEY=ChangeMe_Generate_Strong_Random_Secret_256bit
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ========================================
# API Gateway
# ========================================
API_GATEWAY_HOST=0.0.0.0
API_GATEWAY_PORT=8000
RATE_LIMIT_PER_MINUTE=1000
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# ========================================
# Microservices Hosts
# ========================================
ALERT_INGESTOR_HOST=alert-ingestor
ALERT_INGESTOR_PORT=8001

NORMALIZATION_HOST=normalization
NORMALIZATION_PORT=8002

AI_ML_HOST=ai-ml
AI_ML_PORT=8003

PLAYBOOK_EXECUTOR_HOST=playbook-executor
PLAYBOOK_EXECUTOR_PORT=8004

FORENSIC_COLLECTOR_HOST=forensic-collector
FORENSIC_COLLECTOR_PORT=8005

EVIDENCE_MANAGER_HOST=evidence-manager
EVIDENCE_MANAGER_PORT=8006

CHAIN_CUSTODY_HOST=chain-custody
CHAIN_CUSTODY_PORT=8007

NOTIFICATION_HOST=notification
NOTIFICATION_PORT=8008

DASHBOARD_HOST=dashboard
DASHBOARD_PORT=8009

CONFIG_MANAGER_HOST=config-manager
CONFIG_MANAGER_PORT=8010

COMPLIANCE_REPORTER_HOST=compliance-reporter
COMPLIANCE_REPORTER_PORT=8011

# ========================================
# Sophos Integration (Primary)
# ========================================
# Sophos Central API
SOPHOS_API_HOST=https://api.central.sophos.com
SOPHOS_CLIENT_ID=your_sophos_client_id
SOPHOS_CLIENT_SECRET=your_sophos_client_secret
SOPHOS_TENANT_ID=your_tenant_id

# Sophos Firewall
SOPHOS_FIREWALL_HOST=your_firewall_ip_or_hostname
SOPHOS_FIREWALL_PORT=4444
SOPHOS_FIREWALL_USERNAME=admin
SOPHOS_FIREWALL_PASSWORD=your_firewall_password

# Sophos XDR/EDR
SOPHOS_XDR_ENABLED=true
SOPHOS_PULL_INTERVAL_SECONDS=60

# ========================================
# Additional SIEM/EDR Integrations
# ========================================
# Splunk (if needed in future)
SPLUNK_HOST=
SPLUNK_PORT=8089
SPLUNK_TOKEN=
SPLUNK_INDEX=main

# QRadar (if needed in future)
QRADAR_HOST=
QRADAR_TOKEN=
QRADAR_VERIFY_SSL=true

# Generic Syslog
SYSLOG_ENABLED=true
SYSLOG_PORT=514
SYSLOG_PROTOCOL=UDP

# ========================================
# Threat Intelligence APIs
# ========================================
# VirusTotal
VIRUSTOTAL_API_KEY=your_virustotal_api_key
VIRUSTOTAL_RATE_LIMIT=4

# AlienVault OTX
OTX_API_KEY=your_otx_api_key

# AbuseIPDB
ABUSEIPDB_API_KEY=your_abuseipdb_api_key

# MISP
MISP_URL=
MISP_API_KEY=
MISP_VERIFY_SSL=true

# ========================================
# Notification Channels
# ========================================
# Email (SMTP)
SMTP_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM_EMAIL=soar-alerts@yourcompany.com
SMTP_FROM_NAME=SOAR Pro Alerts

# Slack
SLACK_ENABLED=false
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
SLACK_CHANNEL=#security-alerts

# Microsoft Teams
TEAMS_ENABLED=false
TEAMS_WEBHOOK_URL=https://outlook.office.com/webhook/YOUR/WEBHOOK/URL

# SMS (Twilio)
SMS_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_TO_NUMBERS=+1234567890,+9876543210

# ========================================
# AI/ML Configuration
# ========================================
# Model paths
ML_MODELS_PATH=/app/models
ML_MODEL_ALERT_CLASSIFIER=alert_classifier_v1.pkl
ML_MODEL_ATTACK_PREDICTOR=attack_predictor_v1.h5
ML_MODEL_SIMILARITY=similarity_detector_v1.pkl

# Training
ML_RETRAIN_ENABLED=true
ML_RETRAIN_INTERVAL_DAYS=7
ML_MIN_TRAINING_SAMPLES=1000

# Inference
ML_BATCH_SIZE=32
ML_CONFIDENCE_THRESHOLD=0.75

# ========================================
# Playbook Configuration
# ========================================
PLAYBOOK_SANDBOX_ENABLED=true
PLAYBOOK_MAX_EXECUTION_TIME_SECONDS=3600
PLAYBOOK_APPROVAL_REQUIRED=false
PLAYBOOK_STORAGE_PATH=/app/playbooks

# ========================================
# Forensic Collection
# ========================================
# Evidence collection settings
FORENSIC_ENABLED=true
FORENSIC_AUTO_COLLECT=true
FORENSIC_ENCRYPTION_ENABLED=true
FORENSIC_ENCRYPTION_KEY=ChangeMe_Generate_Strong_AES_256_Key

# Collection intervals
FORENSIC_IMMEDIATE=true
FORENSIC_AFTER_5MIN=true
FORENSIC_AFTER_30MIN=true

# Remote collection
FORENSIC_SSH_KEY_PATH=/app/ssh_keys/collection_key
FORENSIC_WINRM_ENABLED=true

# ========================================
# Chain of Custody
# ========================================
CUSTODY_DIGITAL_SIGNATURE_ENABLED=true
CUSTODY_SIGNING_KEY_PATH=/app/keys/custody_signing.key
CUSTODY_VERIFICATION_KEY_PATH=/app/keys/custody_verification.pub

# ========================================
# Compliance
# ========================================
# Data retention
DATA_RETENTION_DAYS=90
AUDIT_LOG_RETENTION_DAYS=365

# Reports
COMPLIANCE_AUTO_REPORT=true
COMPLIANCE_REPORT_SCHEDULE=0 0 1 * *

# Standards
COMPLIANCE_ISO27001=true
COMPLIANCE_NIST_CSF=true
COMPLIANCE_PCI_DSS=false

# ========================================
# Performance & Scaling
# ========================================
# Worker processes
WORKER_PROCESSES=4
WORKER_THREADS=2

# Queue
QUEUE_MAX_SIZE=10000
QUEUE_BATCH_SIZE=100

# Cache
CACHE_TTL_SECONDS=300
CACHE_MAX_ENTRIES=10000

# ========================================
# Monitoring & Logging
# ========================================
# Logging
LOG_FORMAT=json
LOG_FILE_PATH=/var/log/soar/app.log
LOG_ROTATION=daily
LOG_RETENTION_DAYS=30

# Metrics
METRICS_ENABLED=true
PROMETHEUS_PORT=9090

# Health checks
HEALTH_CHECK_INTERVAL_SECONDS=30

# ========================================
# Security
# ========================================
# Password policy
PASSWORD_MIN_LENGTH=12
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_DIGIT=true
PASSWORD_REQUIRE_SPECIAL=true

# Session
SESSION_TIMEOUT_MINUTES=30
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15

# Encryption
ENCRYPTION_ALGORITHM=AES-256-GCM
DATA_ENCRYPTION_KEY=ChangeMe_Generate_Strong_Data_Encryption_Key

# TLS/SSL
TLS_ENABLED=true
TLS_CERT_PATH=/app/certs/server.crt
TLS_KEY_PATH=/app/certs/server.key

# ========================================
# Frontend
# ========================================
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8009
NEXT_PUBLIC_APP_NAME=SOAR Pro
NEXT_PUBLIC_APP_VERSION=1.0.0

# ========================================
# Backup
# ========================================
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_PATH=/backups

# ========================================
# Development/Testing
# ========================================
# Test mode
TEST_MODE=false
SEED_DATABASE=false

# Mock services (for testing without real integrations)
MOCK_SOPHOS=false
MOCK_THREAT_INTEL=false
MOCK_NOTIFICATIONS=false
